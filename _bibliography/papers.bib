@inproceedings{lin2026dicop,
  preview     = {dicop.png},
  abbr        = {MobiHoc'26},
  bibtex_show = {true},
  title       = {Distributed Collaborative Positioning through ISAC for GPS-Denied Robotic Swarms},
  author      = {Lin*, Yu-Tai and Hsu*, Ting-Wei and Sundaresan, Karthikeyan},
  booktitle   = {Proc. ACM International Symposium on Mobile Ad Hoc Networking and Computing (MobiHoc)},
  year        = {2026},
  note        = {To appear},
  html        = {https://margalab.ece.gatech.edu/projects/ISAC/DiCoP.html},
  selected    = {true},
  annotation  = {* Equal contribution},
  abstract    = {DiCoP is an infrastructure-free distributed collaborative-positioning paradigm for GPS-denied robotic swarms, built on asynchronous multi-static ISAC. A differential sensing technique cancels clock and carrier-frequency-offset errors at O(1) overhead, and a joint distance-velocity optimization lets each node estimate its own position and velocity, while an ISAC-aware MAC prioritizes fast-moving or under-measured nodes. In large-scale NS-3 it keeps sub-2 m error for about 89 percent of nodes with 54.3 ms convergence that stays constant with swarm size, scaling to 100 UAVs.}
}

@inproceedings{lin2026ark,
  preview     = {ark.png},
  abbr        = {NAIC'26},
  bibtex_show = {true},
  title       = {ARK: Avoiding Routing Collisions for KV Cache Transfer in Disaggregated LLM Inference},
  author      = {Lin*, Hung-Chun and Hsu*, Ting-Wei and Ho, Chung-En and Saeed, Ahmed},
  booktitle   = {Proc. ACM SIGCOMM Workshop on Networks for AI Computing (NAIC)},
  address     = {Denver, CO, USA},
  year        = {2026},
  note        = {To appear},
  annotation  = {* Equal contribution},
  abstract    = {ARK is a lightweight, distributed elephant-flow path-reservation mechanism for the massive KV-cache transfers created by prefill-decode disaggregated LLM inference. Using admission-time knowledge of flows, senders pick source ports whose ECMP hashes map concurrent transfers onto distinct spine links, avoiding hash collisions without any switch changes or receiver-side reordering. ARK cuts mean and P95 flow-completion time by up to 27.3 and 34.0 percent and end-to-end time-to-first-token by up to 12.9 percent, keeping per-spine load below about 8 concurrent flows (versus up to 18 under ECMP).},
  selected    = {true}
}

@article{hsu2025iotj,
  preview     = {iotj.png},
  abbr        = {IoT-J},
  bibtex_show = {true},
  title       = {On Using Spatial and Temporal Features for Robust Multiuser Pose Estimation Based on WiFi CSI},
  author      = {Hsu, Ting-Wei and Hsieh, Hung-Yun},
  journal     = iotj,
  volume      = {12},
  number      = {15},
  pages       = {29897--29912},
  year        = {2025},
  publisher   = {IEEE},
  html        = {https://ieeexplore.ieee.org/document/11008528/},
  abstract    = {This work performs multi-user human pose estimation using only off-the-shelf WiFi and a simple linear antenna array. It jointly extracts environment-independent spatial (AoA-ToF) and temporal (AoA-Doppler) features via a modified MUSIC algorithm and an MVDR beamformer, then estimates free-form poses with a deep model, staying robust when the environment layout changes. It improves cross-domain accuracy by about 12 percent (mean PCK) over prior CSI amplitude/phase methods and runs in real time (about 19 FPS).},
  selected    = {true}
}

@inproceedings{hsu2024icc,
  preview     = {icc.png},
  abbr        = {ICC},
  bibtex_show = {true},
  title       = {Robust Multi-User Pose Estimation Based on Spatial and Temporal Features from WiFi CSI},
  author      = {Hsu, Ting-Wei and Hsieh, Hung-Yun},
  booktitle   = {IEEE International Conference on Communications (ICC)},
  address     = {Denver, CO, USA},
  year        = {2024},
  html        = {https://ieeexplore.ieee.org/document/10623053/},
  abstract    = {A WiFi-CSI multi-user pose-estimation system that extracts AoA-ToF and AoA-Doppler heatmaps from a commodity linear antenna array and estimates free-form poses with a 3D-CNN, OpenPose-style model. It outperforms amplitude/phase-based baselines by about 12 percent mean PCK under environment changes.}
}

@inproceedings{hsu2020acc,
